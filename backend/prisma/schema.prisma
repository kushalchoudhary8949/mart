generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                @id @default(autoincrement())
  phone                String             @unique
  role                 Role               @default(CUSTOMER)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  isBlocked            Boolean            @default(false) @map("is_blocked")
  isVerified           Boolean            @default(false) @map("is_verified")
  email                String?
  isActive             Boolean            @default(true) @map("is_active")
  lastLogin            DateTime?          @map("last_login")
  name                 String?
  passwordHash         String?            @map("password_hash")
  addresses            Address[]
  cart                 CartItem[]
  deliveryPartner      DeliveryPartner?
  inventoryAdjustments InventoryHistory[] @relation("AdminAdjustments")
  notifications        Notification[]
  orders               Order[]
  refreshTokens        RefreshToken[]
  wishlist             WishlistItem[]

  @@map("users")
}

model OTP {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([expiresAt])
  @@map("otps")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  slug          String          @unique
  icon          String?
  image         String?
  sortOrder     Int             @default(0) @map("sort_order")
  isActive      Boolean         @default(true) @map("is_active")
  parentId      Int?            @map("parent_id")
  parent        Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[]      @relation("CategoryHierarchy")
  offers        CategoryOffer[]
  products      Product[]

  @@map("categories")
}

model Product {
  id                Int                @id @default(autoincrement())
  categoryId        Int                @map("category_id")
  name              String
  slug              String             @unique
  description       String?
  price             Float
  mrp               Float
  unit              String
  thumbnail         String?
  stock             Int                @default(100)
  rating            Float              @default(4.3)
  ratingCount       Int                @default(0) @map("rating_count")
  isFeatured        Boolean            @default(false) @map("is_featured")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  barcode           String?            @unique
  brand             String?
  costPrice         Float?             @map("cost_price")
  deletedAt         DateTime?          @map("deleted_at")
  gst               Float              @default(0)
  isBestseller      Boolean            @default(false) @map("is_bestseller")
  lowStockThreshold Int                @default(10) @map("low_stock_threshold")
  quantity          Float?
  shortDescription  String?            @map("short_description")
  sku               String?            @unique
  updatedAt         DateTime           @updatedAt @map("updated_at")
  weight            Float?
  cartItems         CartItem[]
  inventoryHistory  InventoryHistory[]
  orderItems        OrderItem[]
  images            ProductImage[]
  offers            ProductOffer[]
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  wishlistItems     WishlistItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Banner {
  id        Int       @id @default(autoincrement())
  title     String
  subtitle  String?
  image     String
  ctaText   String    @default("Shop Now") @map("cta_text")
  ctaLink   String    @default("/categories") @map("cta_link")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("banners")
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  label       String   @default("Home")
  fullAddress String   @map("full_address")
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id                Int                  @id @default(autoincrement())
  orderNo           String               @unique @map("order_no")
  userId            Int                  @map("user_id")
  status            OrderStatus          @default(PENDING)
  subtotal          Float
  discount          Float                @default(0)
  deliveryFee       Float                @default(0) @map("delivery_fee")
  total             Float
  couponCode        String?              @map("coupon_code")
  paymentMethod     String               @default("COD") @map("payment_method")
  paymentStatus     PaymentStatus        @default(PENDING) @map("payment_status")
  addressText       String               @map("address_text")
  deliveryPartnerId Int?                 @map("delivery_partner_id")
  etaMinutes        Int                  @default(30) @map("eta_minutes")
  placedAt          DateTime             @default(now()) @map("placed_at")
  acceptedAt        DateTime?            @map("accepted_at")
  packedAt          DateTime?            @map("packed_at")
  readyForPickupAt  DateTime?            @map("ready_for_pickup_at")
  pickedUpAt        DateTime?            @map("picked_up_at")
  outForDeliveryAt  DateTime?            @map("out_for_delivery_at")
  deliveredAt       DateTime?            @map("delivered_at")
  cancelledAt       DateTime?            @map("cancelled_at")
  rating            Int?
  review            String?
  updatedAt         DateTime             @updatedAt @map("updated_at")
  items             OrderItem[]
  history           OrderStatusHistory[]
  deliveryPartner   DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id])
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deliveryPartnerId, status])
  @@index([status])
  @@map("orders")
}

model DeliveryPartner {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  phone            String   @unique
  name             String
  vehicleType      String   @map("vehicle_type")
  vehicleNumber    String   @map("vehicle_number")
  profileImage     String?  @map("profile_image")
  rating           Float    @default(5)
  isOnline         Boolean  @default(false) @map("is_online")
  isAvailable      Boolean  @default(true) @map("is_available")
  currentLatitude  Float?   @map("current_latitude")
  currentLongitude Float?   @map("current_longitude")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@index([isOnline, isAvailable])
  @@map("delivery_partners")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int?     @map("product_id")
  name      String
  image     String?
  unit      String?
  price     Float
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int         @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String   @default("order")
  orderId   Int?     @map("order_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model InventoryHistory {
  id               Int      @id @default(autoincrement())
  productId        Int      @map("product_id")
  previousQuantity Int      @map("previous_quantity")
  updatedQuantity  Int      @map("updated_quantity")
  difference       Int
  reason           String
  adminUserId      Int      @map("admin_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  admin            User     @relation("AdminAdjustments", fields: [adminUserId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_history")
}

model Offer {
  id           Int             @id @default(autoincrement())
  name         String
  code         String?         @unique
  type         OfferType
  value        Float
  buyQty       Int?            @map("buy_qty")
  getQty       Int?            @map("get_qty")
  startDate    DateTime        @map("start_date")
  endDate      DateTime        @map("end_date")
  usageLimit   Int?            @map("usage_limit")
  usedCount    Int             @default(0) @map("used_count")
  minCartValue Float?          @map("min_cart_value")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  categories   CategoryOffer[]
  products     ProductOffer[]

  @@map("offers")
}

model ProductOffer {
  productId Int     @map("product_id")
  offerId   Int     @map("offer_id")
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, offerId])
  @@map("product_offers")
}

model CategoryOffer {
  categoryId Int      @map("category_id")
  offerId    Int      @map("offer_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([categoryId, offerId])
  @@map("category_offers")
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PACKING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OfferType {
  PERCENTAGE
  FLAT
  BUY_X_GET_Y
}
