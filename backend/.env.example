# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/vrindawan_mart?schema=public"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cors Origin
CORS_ORIGIN=http://localhost:5173

# Rate Limiter
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
